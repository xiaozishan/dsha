<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/marketItemName" style="@style/DshaText.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView android:id="@+id/marketItemDesc" style="@style/DshaText.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <Button android:id="@+id/marketItemInstall" style="@style/Widget.DSHA.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/market_install" />
</LinearLayout>
